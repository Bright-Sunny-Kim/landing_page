[Unit]
Description=HyeAn Portal Flask App (Gunicorn)
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=dskim
Group=dskim
WorkingDirectory=/opt/hyean-portal
EnvironmentFile=/opt/hyean-portal/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/hyean-portal/venv/bin/gunicorn \
    --bind 127.0.0.1:5000 \
    --workers 2 \
    --threads 4 \
    --timeout 120 \
    --access-logfile /var/log/hyean-portal/access.log \
    --error-logfile /var/log/hyean-portal/error.log \
    app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
